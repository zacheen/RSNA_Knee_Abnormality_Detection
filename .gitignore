# Competition data, caches, checkpoints and logs. About 24 GB and partly competition data, which must not be redistributed.
data/

# Upload staging for Kaggle datasets. Everything in it is copied from src/ or data/ by tools/push_assets.sh, plus wheels and checkpoints.
kaggle_datasets/**
!kaggle_datasets/*/
!kaggle_datasets/*/dataset-metadata.json

# Generated by tools/push_kernel.sh from bootstrap, includes and body.py.
kaggle_kernels/*/run.py

# Local-only registers and per-machine settings.
notes/
Known_concern.md
Pending_fix.md
.claude/settings.local.json

__pycache__/
*.pyc
